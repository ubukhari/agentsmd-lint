{
  "name": "@agentwares/agentsmd-lint",
  "version": "0.1.1",
  "description": "Lint AGENTS.md / CLAUDE.md / .cursorrules for stale commands, dead paths, contradictions and missing test or dev-env instructions. Emits an agent-readiness score and an SVG badge. No LLM, no telemetry, no account.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentsmd-lint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/github/worker.d.ts",
      "import": "./dist/github/worker.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents.md",
    "claude.md",
    "cursorrules",
    "lint",
    "linter",
    "coding-agents",
    "claude-code",
    "agent-readiness",
    "badge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentwares/agentsmd-lint"
  },
  "homepage": "https://github.com/agentwares/agentsmd-lint#readme",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build && tsup",
    "prepack": "tsup",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "pnpm -r lint && eslint src",
    "test": "vitest run",
    "self": "node dist/cli.js ../..",
    "pretest": "pnpm run build",
    "pretypecheck": "pnpm run build",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@agentwares/badge": "workspace:^",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/agentwares/agentsmd-lint/issues"
  },
  "packageManager": "pnpm@9.15.9"
}
